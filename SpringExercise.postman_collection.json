						{
							"listen": "test",
							"script": {
								"exec": [
									"// Helper to sort fieldErrors array by all properties",
									"function sortFieldErrors(arr) {",
									"    return arr.slice().sort((a, b) => {",
									"        if (a.field !== b.field) return a.field.localeCompare(b.field);",
									"        if (a.message !== b.message) return a.message.localeCompare(b.message);",
									"        if (a.objectName !== b.objectName) return a.objectName.localeCompare(b.objectName);",
									"        return 0;",
									"    });",
									"}",
									"",
									"pm.test(\"Status code is BAD_REQUEST\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"Body is correct error object\", function () {",
									"    const expected = {",
									"    \"type\": \"https://www.jhipster.tech/problem/constraint-violation\",",
									"    \"title\": \"Method argument not valid\",",
									"    \"status\": 400,",
									"    \"instance\": \"/api/client\",",
									"    \"message\": \"error.validation\",",
									"    \"path\": \"/api/client\",",
									"    \"fieldErrors\": [",
									"        {",
									"            \"field\": \"name\",",
									"            \"message\": \"must not be empty\",",
									"            \"objectName\": \"client\"",
									"        },",
									"        {",
									"            \"field\": \"name\",",
									"            \"message\": \"must not be null\",",
									"            \"objectName\": \"client\"",
									"        }",
									"    ]",
									"};",
									"",
									"    const actual = pm.response.json();",
									"    delete actual.detail",
									"",
									"    // Clone and sort fieldErrors in both objects",
									"    const expectedSorted = _.cloneDeep(expected);",
									"    const actualSorted = _.cloneDeep(actual);",
									"",
									"    expectedSorted.fieldErrors = sortFieldErrors(expectedSorted.fieldErrors);",
									"    actualSorted.fieldErrors = sortFieldErrors(actualSorted.fieldErrors);",
									"",
									"    pm.expect(actualSorted).to.eql(expectedSorted);",
									"});"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
